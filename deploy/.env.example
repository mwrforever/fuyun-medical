# ============================================================================
# fuyun-medical dev 环境环境变量模板（技术栈定稿报告 §6.7 + IoTDA 六变量）
# 用法：复制为 .env 后填写真实值；.env 不入库（根 .gitignore 已含），本模板入库且值只留占位
# 注意：注释必须独立成行——compose env_file 注入容器环境沿用 docker env-file 格式，
#       无行内注释语义，行内 # 及其后内容会混入变量值，禁止改成行内注释
# ============================================================================

# --- PostgreSQL / TimescaleDB ---
# 业务库名（单库多 schema，schema 按 Maven 模块划分，总 Spec §4.4）
# 注意：compose 据此库名拼装 FUYUN_DATASOURCE_URL（已带 reWriteBatchedInserts=true，backend A.4.2-6）；
#       生产/自定义 JDBC URL 需自带该参数，否则批量写优化静默失效
POSTGRES_DB=fuyun_medical
# 数据库用户（backend 与 GUI 工具共用）
POSTGRES_USER=fuyun
# 必填：数据库口令，禁止提交真实值
POSTGRES_PASSWORD=
# 宿主暴露端口（dev 供 GUI 工具连接）
POSTGRES_PORT=5432

# --- Redis ---
# 必填：Redis 口令（容器以 requirepass 启动）
REDIS_PASSWORD=
REDIS_PORT=6379

# --- RabbitMQ ---
# AMQP 用户（首启种子创建，卷持久化后长期留存）
RABBITMQ_USER=fuyun
# 必填：RabbitMQ 口令
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
# 管理台端口（仅 dev/test 暴露）
RABBITMQ_MGMT_PORT=15672

# --- MinIO（仅 dev/test；生产为华为云 OBS，届时改用 OBS 的 AK/SK 变量组） ---
MINIO_ROOT_USER=fuyun
# 必填：root 口令至少 8 位
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000

# --- 华为云 IoTDA（AMQP 订阅 + 模拟设备一机一密；PR-4 端到端演示前填真实值） ---
# AMQP 订阅接入地址，形如 amqps://<实例ID>.iot-mqtts.cn-north-4.huaweicloud.com:5671
IOTDA_AMQP_ENDPOINT=
IOTDA_AMQP_ACCESS_KEY=
# 必填：凭证密钥，禁止提交
IOTDA_AMQP_ACCESS_SECRET=
# 模拟设备上行 MQTT 接入地址
IOTDA_MQTT_HOST=
IOTDA_DEVICE_ID=
# 必填：一机一密，禁止提交
IOTDA_DEVICE_SECRET=

# --- 应用 ---
# backend 激活的 Spring profile
SPRING_PROFILES_ACTIVE=dev
# 必填：令牌 HMAC 签名密钥，≥32 字符，禁止提交真实值（D-2 令牌方案；缺失或过短则 backend 启动 fail-fast）
FUYUN_SECURITY_TOKEN_HMAC_SECRET=
# 必填：IoT 兜底通道共享密钥，禁止提交真实值
FUYUN_IOT_FALLBACK_TOKEN=
# backend 镜像 tag（与 docker build -t fuyun/backend:<tag> 对齐）
BACKEND_TAG=dev
# iot-simulator 镜像 tag（PR-4 落地后使用）
SIMULATOR_TAG=dev
# nginx 宿主暴露端口（唯一公网入口）
NGINX_PORT=80
