# 忽略构建产物与本地环境文件（构建期细化）
target/
node_modules/
dist/
build/
out/
*.log
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
# 真实环境变量不入库（技术栈报告 §6.5 密钥红线）：仓库只提交 .env.example 模板
.env
.env.*
!.env.example
# vite 环境本地覆盖文件（.env.local / .env.*.local）同样不入库
*.local
# unplugin 按需引入构建期生成物（web 简报 §5.6：不入库；首个真实使用按需 API 的 PR 再评估改为入库）
auto-imports.d.ts
components.d.ts
