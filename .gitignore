# 忽略构建产物与本地环境文件（构建期细化）
target/
node_modules/
dist/
build/
out/
*.log
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
# 真实环境变量不入库（技术栈报告 §6.5 密钥红线）：仓库只提交 .env.example 模板
.env
.env.*
!.env.example
# vite 环境本地覆盖文件（.env.local / .env.*.local）同样不入库
*.local
# unplugin 按需引入构建期生成物（web 简报 §5.6：不入库；首个真实使用按需 API 的 PR 再评估改为入库）
auto-imports.d.ts
components.d.ts
# openapi 类型契约生成中间物（PR-2 Task 16 定稿：容器内导出不入库；入库生成物为 packages/shared/src/api.d.ts）
web/api-docs.json
# superpowers 过程面不入库（SDD 台账/审查包/PR body/测试截图 gui-test-screenshots 等，属本地过程产物）
.superpowers/
# 浏览器调试过程面不入库（playwright-cli 会话与截图目录）
.playwright-cli/
# 全仓风险扫描报告与分片（2026-09-28 graph 任务 N0 约定：本地留存禁 add -f）
docs/bugs/
docs/pref/
# impeccable 设计工作区：mocks 样稿/brief 契约/decision 留痕/qualitybar 参考图为交付物入库（2026-10-08 批次2 立项裁决）；运行态与 web app 级 .impeccable 不入库
.impeccable/hook.cache.json
.impeccable/questions/
.impeccable/review/
web/apps/workstation/.impeccable/
# 单文件 >1MB 红线剔除（qualitybar 参考图 1.1MB）
.impeccable/qualitybar/splitflap-board.png
