<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.fuyun</groupId>
    <artifactId>fuyun-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <!-- 业务模块（M20 集成平台与数据服务）：消息治理构件承载模块，治理实现与台账表落本模块（BRIEF-PR2-01 §1）；
       接口与契约（事件信封/幂等接口）沉 fuyun-common，各业务模块零编译期依赖本模块 -->
  <artifactId>fuyun-integration</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Modulith 注解（@NamedInterface api 接口面声明）：package-info 编译期可见，provided 不入运行产物；
         版本 spring-modulith-bom 托管零声明（D-2 裁决，任务 9） -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- RabbitMQ 领域事件总线治理：交换机/队列声明构件与死信统一队列（backend 宪法 A.5-4/A.5-5） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <!-- 消费幂等 Redis 前置去重（backend 宪法 A.5-6），StringRedisTemplate 承载 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- event_registry 台账数据访问：spring-boot3 后缀 starter（禁再引入 mybatis-spring 系，宪法 A.4.3-12） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
    </dependency>
    <!-- 配置属性启动期校验（@Validated + JSR-303 约束，backend 宪法 A.2-2） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- DTO/VO 映射（A.7-4）：IntegrationConverter，版本父 POM 托管，处理器路径父 compiler 插件已配置 -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
    </dependency>
    <!-- Web 层显式声明（本模块新增 @RestController 后按模块显式声明风格落盘，二选一取显式）：
         此前经 fuyun-common 传递可得（fuyun-common pom 声明 starter-web），显式声明使本模块 Web 依赖自洽、
         不依赖传递路径稳定性；版本 Boot BOM 托管，禁写版本号 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Lombok（BOM 托管版本）：@Getter/@Setter/@Slf4j 编译期依赖，provided 不打进运行产物 -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
