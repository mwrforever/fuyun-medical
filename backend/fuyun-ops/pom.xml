<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.fuyun</groupId>
    <artifactId>fuyun-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <!-- 业务模块（M19 运营与决策支持）：批次 2 册 2 首切片（工作台两聚合端点）。本模块零表零迁移
       （分析型只读——M19 红线 1，全部取数经四业务模块统计 Port），不引 mybatis-plus starter；
       依赖面对齐 fuyun-ward 实证清单裁剪：common + 四兄弟模块 api 面（outpatient/billing/
       pharmacy/nursing——仅消费各 api NamedInterface，宪法 B.2-2 允许，Modulith verify 把关）+
       springdoc（REST 面与 @Tag/@Operation 注解）/ validation / data-redis（overview 快照缓存）
       / modulith-api（api 包 package-info @NamedInterface 声明）/ lombok / test -->
  <artifactId>fuyun-ops</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 兄弟模块 api 面（宪法 B.2-2：只依赖其他模块 api 包，禁 impl；inpatient/ward pom 先例） -->
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-outpatient</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-billing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-pharmacy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-nursing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- spring-modulith-api（provided，BOM 托管零声明）：api 包 package-info @NamedInterface 声明依赖 -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- 基础设施：springdoc（REST 面传递引入 spring-webmvc）/ starter-validation（@Validated）/
         starter-data-redis（overview 快照 TTL 5s 缓存，StringRedisTemplate）——版本全部 BOM
         托管零声明（ward pom 同源，禁自行声明版本），零新依赖引入 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <!-- API 文档注解（宪法 A.3-7；Springdoc 2.8.17 禁升 3.x，版本与 fuyun-app 同源锁定，非 BOM 托管） -->
      <version>2.8.17</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- Lombok（BOM 托管版本）：VO 编译期依赖，provided 不打进运行产物 -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- 测试：聚合 service 单测（JUnit/AssertJ/Mockito），BOM 托管版本 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
