<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.fuyun</groupId>
  <artifactId>fuyun-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <!-- fuyun-medical 后端父 POM：唯一版本锁定与插件门禁入口。
       不继承 spring-boot-starter-parent（backend 宪法 B.1），以 import scope 导入 Boot BOM；
       Boot BOM 托管依赖禁止在此覆盖版本，非托管依赖集中声明于 dependencyManagement。 -->

  <!-- 模块清单：common → 20 业务域（对齐总 Spec M01-M20）→ app（装配入口）；实际构建顺序由 Maven 依赖分析决定 -->
  <modules>
    <module>fuyun-common</module>
    <module>fuyun-system</module>
    <module>fuyun-patient</module>
    <module>fuyun-outpatient</module>
    <module>fuyun-inpatient</module>
    <module>fuyun-nursing</module>
    <module>fuyun-pharmacy</module>
    <module>fuyun-lab</module>
    <module>fuyun-imaging</module>
    <module>fuyun-emr</module>
    <module>fuyun-surgery</module>
    <module>fuyun-icu</module>
    <module>fuyun-transfusion</module>
    <module>fuyun-billing</module>
    <module>fuyun-iot</module>
    <module>fuyun-asset</module>
    <module>fuyun-ward</module>
    <module>fuyun-peis</module>
    <module>fuyun-internet</module>
    <module>fuyun-ops</module>
    <module>fuyun-integration</module>
    <module>fuyun-app</module>
  </modules>

  <properties>
    <!-- 编码红线：全项目 UTF-8（根定位层 §7） -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Java 17 基线（backend 宪法 C.2，冻结版本行） -->
    <maven.compiler.release>17</maven.compiler.release>
    <!-- 补齐 starter-parent 默认行为：构造器绑定（@ConfigurationProperties/@RequestParam）依赖参数名 -->
    <maven.compiler.parameters>true</maven.compiler.parameters>

    <!-- Boot BOM：import scope 不继承 BOM properties，版本须显式声明（backend 宪法 C.2 冻结 3.5.16） -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <!-- 非 BOM 托管依赖版本（backend 宪法 C.2 版本表） -->
    <lombok.version>1.18.46</lombok.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <!-- 表外版本：MapStruct 官方文档标准搭配值，BRIEF-PR1-01 §9-2 默认方案，PR 描述申报 -->
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <qpid-jms.version>2.11.0</qpid-jms.version>
    <shedlock.version>6.10.0</shedlock.version>
    <archunit.version>1.5.0</archunit.version>

    <!-- 门禁插件版本：jacoco 不在 Boot BOM 托管范围，必须显式（backend 宪法 C.5-2）；spotless 锁定值（C.5-3） -->
    <jacoco.version>0.8.15</jacoco.version>
    <spotless.version>3.4.0</spotless.version>
    <!-- 表外版本：取 spring-boot-dependencies:3.5.16 pluginManagement 原值锁定，与 Boot 工具链一致（BRIEF-PR1-01 §9-1 默认方案，PR 描述申报） -->
    <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 第一条：Spring Boot BOM（backend 宪法 C.2 版本唯一权威来源） -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- BOM 外依赖集中声明：版本全部引用 properties，禁止子模块自带版本号 -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-jsqlparser</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.qpid</groupId>
        <artifactId>qpid-jms-client</artifactId>
        <version>${qpid-jms.version}</version>
      </dependency>
      <dependency>
        <groupId>net.javacrumbs.shedlock</groupId>
        <artifactId>shedlock-spring</artifactId>
        <version>${shedlock.version}</version>
      </dependency>
      <dependency>
        <groupId>net.javacrumbs.shedlock</groupId>
        <artifactId>shedlock-provider-jdbc-template</artifactId>
        <version>${shedlock.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>17</release>
            <parameters>true</parameters>
            <!-- 注解处理器固定顺序（顺序影响可见性，不得调换）：
                 1 Lombok 生成 getter/setter → 2 MapStruct 处理器 → 3 binding 使 Lombok 产物对 MapStruct 可见 → 4 Boot 配置元数据 -->
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
              </path>
              <path>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-configuration-processor</artifactId>
                <version>${spring-boot.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <!-- palantir 默认版本属 TASK.md T-R5-2 待调研项，首跑确认后再议；禁 google-java-format（JDK17 红线，backend 宪法 C.6-2） -->
              <palantirJavaFormat/>
              <importOrder/>
              <removeUnusedImports/>
              <endWithNewline/>
            </java>
          </configuration>
          <executions>
            <execution>
              <id>spotless-check</id>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- 单测命名约定（backend 宪法 C.4）；禁止自定义 argLine（会吞掉 jacoco agent 注入） -->
            <includes>
              <include>**/*Test.java</include>
            </includes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <!-- 集成测试命名约定（backend 宪法 C.4）；禁止自定义 argLine -->
            <includes>
              <include>**/*IT.java</include>
            </includes>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <configuration>
            <!-- 排除 config/properties/dto/entity/Application/MapStruct 生成物（backend 宪法 C.5-2），规则现在写全避免实装时遗漏 -->
            <excludes>
              <exclude>com/fuyun/**/config/**</exclude>
              <exclude>com/fuyun/**/properties/**</exclude>
              <exclude>com/fuyun/**/dto/**</exclude>
              <exclude>com/fuyun/**/entity/**</exclude>
              <!-- 常量类仅私有构造器 + 字面量，无私有逻辑，与 config/properties 同语义排除
                   （宪法 C.5-2 排除清单扩展项，BRIEF-PR2-01 §8-7，PR 描述申报） -->
              <exclude>com/fuyun/**/constants/**</exclude>
              <exclude>**/FuyunApplication.class</exclude>
              <exclude>**/*ConverterImpl.class</exclude>
            </excludes>
            <rules>
              <!-- 规则一：全部模块 BUNDLE 行覆盖 ≥ 0.80（非核心底线） -->
              <rule>
                <element>BUNDLE</element>
                <limits>
                  <limit>
                    <counter>LINE</counter>
                    <value>COVEREDRATIO</value>
                    <minimum>0.80</minimum>
                  </limit>
                </limits>
              </rule>
              <!-- 规则二：核心包 PACKAGE 级 LINE ≥ 1.00（integration 治理域 B2.2 起首个真实生效：
                   MessageIdempotencyServiceImpl/EventRegistryServiceImpl/QueueGovernorImpl 三类全覆盖；
                   billing/system 随模块实装生效；包不存在时规则匹配零包平凡通过，
                   第一个类出现即门禁立即生效，禁止改用注释开关） -->
              <rule>
                <element>PACKAGE</element>
                <includes>
                  <include>com.fuyun.integration.service.impl</include>
                  <include>com.fuyun.billing.service.impl</include>
                  <include>com.fuyun.system.service.impl</include>
                  <!-- iot 消费落库链核心包（B4.2 起随首个 service.impl 实装生效，BRIEF-PR4-01 §7；
                       CHANGELOG 2026-09-10 条目先记再改，PR 描述申报） -->
                  <include>com.fuyun.iot.service.impl</include>
                </includes>
                <limits>
                  <limit>
                    <counter>LINE</counter>
                    <value>COVEREDRATIO</value>
                    <minimum>1.00</minimum>
                  </limit>
                </limits>
              </rule>
            </rules>
          </configuration>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- 非默认生命周期绑定的三个插件显式启用（子模块零配置继承）；
           同一 verify 阶段按声明顺序执行：spotless 格式快速失败 → failsafe 集成测试 → jacoco 报告与门禁 -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
