<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.fuyun</groupId>
    <artifactId>fuyun-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <!-- 业务模块（M05 护理管理（含移动护理））：P1 PR-6 起落迁移与业务实现，依赖面照 fuyun-outpatient
       实证清单裁剪（兄弟 api 原仅三类；billing/pharmacy/iot 持续禁依赖）；P2 PR-3 增补
       fuyun-inpatient api 面单向依赖（OrderExecutionConfirmPort 执行回签端口，进程内直调不走
       HTTP 自调；inpatient 不依赖 nursing 无环，Modulith verify 把关，实况修订申报——ward pom
       P2 PR-2 增补 fuyun-iot 先例） -->
  <artifactId>fuyun-nursing</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 兄弟模块 api 面（system/patient/integration 三类 + P2 PR-3 增补 inpatient；禁依赖
         pharmacy/billing/iot——nursing 对 iot 数据一律经事件与前端组合，反向依赖会与 iot→nursing 成环） -->
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-system</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-patient</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- P2 PR-3 增补：inpatient api 面（OrderExecutionConfirmPort 医嘱执行回签端口，执行单
         COMPLETED 后进程内直调 IOrderPlanService.executeConfirm 逻辑）——仅 api 面单向依赖，
         Modulith verify() 把关；inpatient 不依赖 nursing，无环（版本归父 POM 管理形态，
         fuyun-ward pom 对 fuyun-iot 声明先例） -->
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-inpatient</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 基础设施：spring-modulith-api(provided) / springdoc-openapi-starter-webmvc-ui / starter-validation /
         starter-amqp / starter-data-redis / mybatis-plus starter + jsqlparser / lombok(provided) /
         spring-boot-starter-test(test) —— 版本与 scope 逐字照 outpatient pom，禁自行声明版本 -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.8.17</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
    </dependency>
    <!-- /ws/nursing STOMP 端点（P2 PR-3 Task 11 / FU-M05-08）：@EnableWebSocketMessageBroker +
         内存 SimpleBroker(/topic)，无 SockJS（客户端仅 bigscreen 原生 WebSocket——iot/outpatient
         先例同款）；版本 BOM 托管零声明 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
