<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.fuyun</groupId>
    <artifactId>fuyun-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <!-- 业务模块（M04 住院管理）：P2 PR-1 起落迁移与业务实现，依赖面对齐 fuyun-nursing 实证清单
       （兄弟 api 四类——billing 仅消费其 api 包进程内端口，outpatient→billing 既有依赖先例，
       api 面可见性由 Modulith 把关；pharmacy/nursing/outpatient/iot 禁依赖） -->
  <artifactId>fuyun-inpatient</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 兄弟模块 api 面（system：审计注解与执业授权端口；patient：PatientContextResolver/
         VisitIdValidator/AllergyChecker/OngoingVisitQuery；integration：MessagingGovernance） -->
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-system</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-patient</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 收费域：BillingAccountQueryPort（出院费用预审只读端口，进程内）——outpatient→billing 先例 -->
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-billing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 基础设施：spring-modulith-api(provided) / springdoc-openapi-starter-webmvc-ui / starter-validation /
         starter-amqp / starter-data-redis / mybatis-plus starter + jsqlparser / lombok(provided) /
         spring-boot-starter-test(test) —— 版本与 scope 逐字照 nursing pom，禁自行声明版本 -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.8.17</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
    </dependency>
    <!-- 日切分解定时任务守护（A.5-14 多实例 @Scheduled 强制，父 POM 锁版本——patient 段同款） -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
