<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.fuyun</groupId>
    <artifactId>fuyun-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <!-- 装配模块：全后端唯一可执行入口，聚合配置与全部模块，不放业务逻辑（backend 宪法 B.1）；
       P0 依赖集（P0 计划 §1-PR-1），版本一律来自父 POM dependencyManagement，禁止自带版本号 -->
  <artifactId>fuyun-app</artifactId>

  <dependencies>
    <!-- Web/校验/AOP/可观测基座 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Redis（Lettuce 默认）/ RabbitMQ 领域事件总线 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <!-- 数据访问：MyBatis-Plus（spring-boot3 后缀 starter，禁再引入 mybatis-spring 系，backend 宪法 A.4.3-12） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
    </dependency>
    <!-- 迁移：Flyway，PG 方言拆分模块必须显式声明（缺失则迁移直接报错） -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- IoTDA AMQP 消费（M14 骨架，与 Spring AMQP 连接完全隔离） -->
    <dependency>
      <groupId>org.apache.qpid</groupId>
      <artifactId>qpid-jms-client</artifactId>
    </dependency>
    <!-- Spring Modulith：事件发布注册表 JDBC 持久化（D-2 裁决，宪法 B.2-6/B.3-3）；
         events-jackson 提供 serialized_event 的 JSON 序列化（EventSerializer 自动装配）；
         starter-jdbc 传递引入 spring-modulith-api/core，保证 @Modulithic/ApplicationModuleListener 编译期可见
         （注：简报原列 spring-modulith 空聚合器不在 BOM 托管范围且不携带类，已移除，申报见 task-2-report） -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-events-jackson</artifactId>
    </dependency>
    <!-- 定时任务多实例互斥：ShedLock JDBC provider 复用业务 PG -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-provider-jdbc-template</artifactId>
    </dependency>
    <!-- API 文档（宪法 A.3-7/C.2：Springdoc 2.8.17 禁升 3.x；契约=DTO 注解推导生成；
         Swagger UI 仅 dev/test 默认姿态，prod 两键已在 application-prod.yml 兜底） -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.8.17</version>
    </dependency>
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- M20 集成平台：消息治理构件与 event_registry 台账（装配经 MessagingConfig @Import 引入，
         @Import 需编译期可见性，BRIEF-PR2-01 §2.10 装配要求的必要依赖，PR 描述申报） -->
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- M01 系统与权限管理：CF-2 主数据事件契约（发布方 api 包，backend 宪法 B.3-1/B.2-2）；
         B2.3 端到端 IT 以真实载荷发布 system.dict.published，装配模块聚合业务模块属 B.1 既有职责，
         PR-3 M01 实装后由装配刚需承接（BRIEF-PR2-01 §1.2 表外依赖，PR 描述申报） -->
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-system</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- M14 医疗设备物联网：V400+ 迁移资源（db/migration/iot）随本依赖进入 fuyun-app 的 Flyway
         classpath（spring.flyway.locations 已显式枚举该目录）；B4.2 起 IotConfig @Import 装配刚需
         同源（BRIEF-PR4-01 §2 申报：原计划随 B4.2 落 pom，因 B4.1 IotMigrationIT 须真实重放 iot
         迁移前移至本批，PR 描述申报） -->
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-iot</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- M02 患者主索引（P1 PR-2）：模块装配经本模块 PatientConfig @Import（装配归 app，B.1） -->
    <dependency>
      <groupId>com.fuyun</groupId>
      <artifactId>fuyun-patient</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 测试：单测 + Testcontainers 集成测试 + 架构边界守护（规则类自 PR-2 起编写） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Modulith 边界校验（ApplicationModules/verify）与依赖图生成（Documenter） -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-docs</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- repackage 产出可执行 fat jar（不继承 starter-parent 必须显式绑定，Dockerfile 的 mvn package 依赖此产物）。
           classifier=exec：fat jar 落 -exec.jar 后缀，主构件保持薄 jar——repackage 默认在位替换会让 failsafe
           集成测试的 classpath 拿到 BOOT-INF 布局 fat jar，应用类对普通类加载器不可见导致 @SpringBootTest 装配失败 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
